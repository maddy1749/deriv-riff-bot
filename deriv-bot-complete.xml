<?xml version="1.0" encoding="UTF-8"?>
<deriv_bot>
  <bot_info>
    <name>Riff Bot</name>
    <version>1.0.0</version>
    <description>Automated trading bot using digit frequency analysis</description>
  </bot_info>

  <configuration>
    <api_token></api_token>
    <account_type>demo</account_type>
    <currency>USD</currency>
  </configuration>

  <trading_settings>
    <symbol>R_100</symbol>
    <contract_type>DIGITDIFF</contract_type>
    <stake>0.35</stake>
    <duration>1</duration>
    <duration_unit>t</duration_unit>
  </trading_settings>

  <strategy>
    <type>digit_frequency</type>
    <analysis_window>500</analysis_window>
    <threshold>0.15</threshold>
    <max_loss>6.00</max_loss>
    <max_trades>20</max_trades>
    <trade_delay>500</trade_delay>
  </strategy>

  <rules>
    <rule>
      <name>extract_digit</name>
      <action>Extract last digit from price quote</action>
    </rule>
    
    <rule>
      <name>count_frequency</name>
      <action>Count occurrences of digits 0-9 in analysis window</action>
    </rule>
    
    <rule>
      <name>generate_signal</name>
      <action>If DIGITMATCH: find most frequent digit. If DIGITDIFF: find least frequent digit</action>
    </rule>
    
    <rule>
      <name>check_threshold</name>
      <action>If DIGITMATCH and frequency >= threshold, generate BUY signal. If DIGITDIFF and frequency &lt;= threshold, generate BUY signal</action>
    </rule>
    
    <rule>
      <name>validate_trade</name>
      <action>Check authorization, balance, max loss, max trades before executing</action>
    </rule>
    
    <rule>
      <name>execute_trade</name>
      <action>Send proposal request and auto-buy contract</action>
    </rule>
    
    <rule>
      <name>monitor_contract</name>
      <action>Subscribe to contract updates until settlement</action>
    </rule>
    
    <rule>
      <name>record_result</name>
      <action>Record win/loss, update P/L and statistics</action>
    </rule>
  </rules>

  <risk_management>
    <max_loss>6.00</max_loss>
    <max_trades>20</max_trades>
    <stop_on_max_loss>true</stop_on_max_loss>
    <stop_on_max_trades>true</stop_on_max_trades>
  </risk_management>

  <websocket>
    <url>wss://ws.binaryws.com/websockets/v3</url>
    <reconnect>true</reconnect>
    <reconnect_delay>5000</reconnect_delay>
  </websocket>

  <operations>
    <operation name="connect">
      <step>1. Connect to WebSocket</step>
      <step>2. Send authorize message with API token</step>
      <step>3. Wait for authorization response</step>
      <step>4. Request historical ticks</step>
      <step>5. Subscribe to live ticks</step>
    </operation>

    <operation name="analyze">
      <step>1. On each new tick, extract last digit</step>
      <step>2. Add to digits array</step>
      <step>3. Count frequency of each digit 0-9</step>
      <step>4. Determine max and min frequency digits</step>
      <step>5. Calculate percentage for signal digit</step>
      <step>6. Compare against threshold</step>
      <step>7. If condition met, generate trade signal</step>
    </operation>

    <operation name="trade">
      <step>1. Validate bot is authorized</step>
      <step>2. Check current P/L against max_loss</step>
      <step>3. Check trade count against max_trades</step>
      <step>4. Verify no active contract</step>
      <step>5. Send proposal request with signal target</step>
      <step>6. Receive proposal with pricing</step>
      <step>7. Send buy request at market price</step>
      <step>8. Monitor contract status</step>
      <step>9. When settled, record result</step>
      <step>10. Wait trade_delay milliseconds</step>
    </operation>

    <operation name="stop">
      <step>1. Set running flag to false</step>
      <step>2. Close active contract if any</step>
      <step>3. Print final session statistics</step>
      <step>4. Disconnect WebSocket</step>
    </operation>
  </operations>

  <messages>
    <send_message>
      <name>authorize</name>
      <format>{"authorize": "API_TOKEN", "req_id": 1}</format>
    </send_message>

    <send_message>
      <name>ticks_history</name>
      <format>{"ticks_history": "SYMBOL", "count": 500, "end": "latest", "style": "ticks", "req_id": 2}</format>
    </send_message>

    <send_message>
      <name>subscribe_ticks</name>
      <format>{"ticks": "SYMBOL", "subscribe": 1, "req_id": 3}</format>
    </send_message>

    <send_message>
      <name>proposal</name>
      <format>{"proposal": 1, "amount": 0.35, "basis": "stake", "contract_type": "DIGITDIFF", "currency": "USD", "duration": 1, "duration_unit": "t", "barrier": "7", "underlying_symbol": "R_100", "req_id": 4}</format>
    </send_message>

    <send_message>
      <name>buy</name>
      <format>{"buy": "PROPOSAL_ID", "price": 0.35, "req_id": 5}</format>
    </send_message>

    <send_message>
      <name>monitor_contract</name>
      <format>{"proposal_open_contract": 1, "contract_id": "CONTRACT_ID", "subscribe": 1, "req_id": 6}</format>
    </send_message>

    <receive_message>
      <name>authorize</name>
      <fields>loginid, balance, currency, mt5_login_list</fields>
    </receive_message>

    <receive_message>
      <name>history</name>
      <fields>msg_type, history (prices array)</fields>
    </receive_message>

    <receive_message>
      <name>tick</name>
      <fields>msg_type, tick (quote, symbol, epoch)</fields>
    </receive_message>

    <receive_message>
      <name>proposal</name>
      <fields>msg_type, proposal (id, ask_price, barrier, payout)</fields>
    </receive_message>

    <receive_message>
      <name>buy</name>
      <fields>msg_type, buy (contract_id, transaction_id)</fields>
    </receive_message>

    <receive_message>
      <name>proposal_open_contract</name>
      <fields>msg_type, proposal_open_contract (contract_id, is_sold, profit, status)</fields>
    </receive_message>
  </messages>

  <states>
    <state>
      <name>OFFLINE</name>
      <description>Not connected</description>
    </state>
    
    <state>
      <name>CONNECTING</name>
      <description>Connecting to WebSocket</description>
    </state>
    
    <state>
      <name>CONNECTED</name>
      <description>WebSocket connected, awaiting auth</description>
    </state>
    
    <state>
      <name>AUTHORIZED</name>
      <description>Authorized and ready</description>
    </state>
    
    <state>
      <name>RUNNING</name>
      <description>Bot is trading</description>
    </state>
    
    <state>
      <name>STOPPED</name>
      <description>Bot is stopped</description>
    </state>
  </states>

  <statistics>
    <stat name="total_trades">0</stat>
    <stat name="wins">0</stat>
    <stat name="losses">0</stat>
    <stat name="profit_loss">0.00</stat>
    <stat name="win_rate">0.00</stat>
    <stat name="balance">0.00</stat>
  </statistics>

  <security>
    <requires_authorization>true</requires_authorization>
    <token_scope>trade</token_scope>
    <uses_wss>true</uses_wss>
    <never_log_token>true</never_log_token>
  </security>

  <error_handling>
    <error>
      <condition>WebSocket connection fails</condition>
      <action>Retry with exponential backoff</action>
    </error>
    
    <error>
      <condition>Authorization fails</condition>
      <action>Stop bot and return error message</action>
    </error>
    
    <error>
      <condition>Insufficient balance</condition>
      <action>Stop bot and log insufficient funds</action>
    </error>
    
    <error>
      <condition>Proposal fails</condition>
      <action>Skip trade and continue monitoring</action>
    </error>
    
    <error>
      <condition>API error response</condition>
      <action>Log error message and continue or stop based on severity</action>
    </error>
  </error_handling>

  <performance>
    <recommended_settings>
      <setting name="conservative">
        <symbol>R_25</symbol>
        <stake>0.35</stake>
        <analysis_window>1000</analysis_window>
        <threshold>0.20</threshold>
        <max_loss>3.50</max_loss>
        <max_trades>10</max_trades>
      </setting>
      
      <setting name="balanced">
        <symbol>R_100</symbol>
        <stake>0.35</stake>
        <analysis_window>500</analysis_window>
        <threshold>0.15</threshold>
        <max_loss>6.00</max_loss>
        <max_trades>20</max_trades>
      </setting>
      
      <setting name="aggressive">
        <symbol>R_100</symbol>
        <stake>1.00</stake>
        <analysis_window>200</analysis_window>
        <threshold>0.10</threshold>
        <max_loss>15.00</max_loss>
        <max_trades>50</max_trades>
      </setting>
    </recommended_settings>
  </performance>

  <disclaimer>
    <warning>Real trading can result in loss of capital</warning>
    <warning>Test in demo mode first</warning>
    <warning>Frequency analysis provides no guarantee of profit</warning>
    <warning>Past performance does not indicate future results</warning>
  </disclaimer>

</deriv_bot>
