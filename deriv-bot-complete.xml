<?xml version="1.0" encoding="UTF-8"?>
<bot>
  <metadata>
    <name>Riff Bot - Deriv Trading Bot</name>
    <version>1.0.0</version>
    <description>Automated trading bot using digit frequency analysis</description>
    <author>maddy1749</author>
    <created>2026-08-29</created>
    <platform>deriv</platform>
  </metadata>

  <settings>
    <connection>
      <url>wss://ws.binaryws.com/websockets/v3</url>
      <protocol>websocket</protocol>
      <secure>true</secure>
    </connection>

    <trading>
      <mode>demo</mode>
      <symbol>R_100</symbol>
      <contractType>DIGITDIFF</contractType>
      <stake>0.35</stake>
      <duration>1</duration>
      <durationUnit>t</durationUnit>
    </trading>

    <strategy>
      <analysisWindow>500</analysisWindow>
      <threshold>0.15</threshold>
      <maxLoss>6.00</maxLoss>
      <maxTrades>20</maxTrades>
      <tradeDelay>500</tradeDelay>
    </strategy>
  </settings>

  <logic>
    <initialization>
      <step>1. Connect to Deriv WebSocket API</step>
      <step>2. Authorize with API token</step>
      <step>3. Subscribe to market ticks</step>
      <step>4. Load historical price data</step>
      <step>5. Initialize digit frequency tracker</step>
      <step>6. Start monitoring market</step>
    </initialization>

    <mainLoop>
      <onTick>
        <action>Extract last digit from price</action>
        <action>Add digit to frequency array</action>
        <action>Calculate digit frequencies</action>
        <action>Analyze trading signal</action>
        <condition>if signal and no active contract</condition>
        <action>Execute trade</action>
      </onTick>
    </mainLoop>

    <signalGeneration>
      <type>DIGITMATCH</type>
      <description>Trade on most frequent digit</description>
      <logic>
        <step>Find digit with highest frequency</step>
        <step>Calculate frequency percentage</step>
        <condition>if frequency >= threshold</condition>
        <signal>Place DIGITMATCH contract on this digit</signal>
      </logic>

      <type>DIGITDIFF</type>
      <description>Trade on least frequent digit NOT appearing</description>
      <logic>
        <step>Find digit with lowest frequency</step>
        <step>Calculate frequency percentage</step>
        <condition>if frequency &lt;= threshold</condition>
        <signal>Place DIGITDIFF contract, predict other digits appear</signal>
      </logic>
    </signalGeneration>

    <tradeExecution>
      <step>1. Validate signal strength</step>
      <step>2. Check risk limits (max loss, max trades)</step>
      <step>3. Verify account has sufficient balance</step>
      <step>4. Request proposal from Deriv API</step>
      <step>5. Auto-buy at market price</step>
      <step>6. Monitor contract until settlement</step>
      <step>7. Record win/loss</step>
      <step>8. Update P/L and statistics</step>
      <step>9. Wait trade delay period</step>
      <step>10. Resume monitoring for next signal</step>
    </tradeExecution>

    <riskManagement>
      <check>
        <name>Maximum Loss Limit</name>
        <condition>if cumulative_pl &lt;= -max_loss</condition>
        <action>STOP BOT IMMEDIATELY</action>
      </check>

      <check>
        <name>Maximum Trades Limit</name>
        <condition>if trade_count >= max_trades</condition>
        <action>STOP BOT IMMEDIATELY</action>
      </check>

      <check>
        <name>Active Contract Check</name>
        <condition>if contract_is_open</condition>
        <action>WAIT for settlement before next trade</action>
      </check>

      <check>
        <name>Authorization Check</name>
        <condition>if not authorized</condition>
        <action>BLOCK all trading</action>
      </check>

      <check>
        <name>Balance Check</name>
        <condition>if balance &lt; stake</condition>
        <action>STOP BOT - insufficient funds</action>
      </check>
    </riskManagement>
  </logic>

  <apiMessages>
    <send>
      <message>
        <name>authorize</name>
        <format>{"authorize": "API_TOKEN"}</format>
        <description>Authenticate with Deriv</description>
      </message>

      <message>
        <name>ticks_history</name>
        <format>{"ticks_history": "SYMBOL", "count": 500, "end": "latest", "style": "ticks"}</format>
        <description>Request historical tick data</description>
      </message>

      <message>
        <name>subscribe_ticks</name>
        <format>{"ticks": "SYMBOL", "subscribe": 1}</format>
        <description>Subscribe to live tick updates</description>
      </message>

      <message>
        <name>request_proposal</name>
        <format>{"proposal": 1, "amount": 0.35, "basis": "stake", "contract_type": "DIGITDIFF", "currency": "USD", "duration": 1, "duration_unit": "t", "barrier": "7", "underlying_symbol": "R_100"}</format>
        <description>Request contract proposal</description>
      </message>

      <message>
        <name>buy_contract</name>
        <format>{"buy": "PROPOSAL_ID", "price": 0.35}</format>
        <description>Execute trade</description>
      </message>

      <message>
        <name>monitor_contract</name>
        <format>{"proposal_open_contract": 1, "contract_id": "CONTRACT_ID", "subscribe": 1}</format>
        <description>Monitor open contract</description>
      </message>
    </send>

    <receive>
      <message>
        <name>authorize</name>
        <fields>
          <field name="msg_type">authorize</field>
          <field name="authorize">Object with loginid, balance, currency</field>
        </fields>
      </message>

      <message>
        <name>history</name>
        <fields>
          <field name="msg_type">history</field>
          <field name="history">Object with prices array</field>
        </fields>
      </message>

      <message>
        <name>tick</name>
        <fields>
          <field name="msg_type">tick</field>
          <field name="tick">Object with quote, symbol, epoch</field>
        </fields>
      </message>

      <message>
        <name>proposal</name>
        <fields>
          <field name="msg_type">proposal</field>
          <field name="proposal">Object with id, ask_price, barrier</field>
        </fields>
      </message>

      <message>
        <name>buy</name>
        <fields>
          <field name="msg_type">buy</field>
          <field name="buy">Object with contract_id, transaction_id</field>
        </fields>
      </message>

      <message>
        <name>proposal_open_contract</name>
        <fields>
          <field name="msg_type">proposal_open_contract</field>
          <field name="proposal_open_contract">Object with contract_id, is_sold, profit, status</field>
        </fields>
      </message>
    </receive>
  </apiMessages>

  <stateManagement>
    <states>
      <state>
        <name>OFFLINE</name>
        <description>Not connected to Deriv</description>
        <transitions>
          <transition>to:CONNECTING on connect()</transition>
        </transitions>
      </state>

      <state>
        <name>CONNECTING</name>
        <description>Attempting WebSocket connection</description>
        <transitions>
          <transition>to:CONNECTED on successful connection</transition>
          <transition>to:OFFLINE on connection failure</transition>
        </transitions>
      </state>

      <state>
        <name>CONNECTED</name>
        <description>WebSocket connected, awaiting authorization</description>
        <transitions>
          <transition>to:AUTHORIZED on successful auth</transition>
          <transition>to:OFFLINE on disconnect</transition>
        </transitions>
      </state>

      <state>
        <name>AUTHORIZED</name>
        <description>Authorized with API, ready to trade</description>
        <transitions>
          <transition>to:RUNNING_DEMO on start() in demo mode</transition>
          <transition>to:RUNNING_REAL on start() in real mode</transition>
          <transition>to:OFFLINE on disconnect</transition>
        </transitions>
      </state>

      <state>
        <name>RUNNING_DEMO</name>
        <description>Bot trading in demo mode</description>
        <transitions>
          <transition>to:STOPPED on stop()</transition>
          <transition>to:OFFLINE on disconnect</transition>
        </transitions>
      </state>

      <state>
        <name>RUNNING_REAL</name>
        <description>Bot trading with real money</description>
        <transitions>
          <transition>to:STOPPED on stop()</transition>
          <transition>to:OFFLINE on disconnect</transition>
        </transitions>
      </state>

      <state>
        <name>STOPPED</name>
        <description>Bot is stopped</description>
        <transitions>
          <transition>to:RUNNING_DEMO on start() in demo mode</transition>
          <transition>to:RUNNING_REAL on start() in real mode</transition>
          <transition>to:OFFLINE on disconnect</transition>
        </transitions>
      </state>
    </states>

    <variables>
      <variable name="connected" type="boolean">WebSocket connection status</variable>
      <variable name="authorized" type="boolean">API authorization status</variable>
      <variable name="running" type="boolean">Bot trading status</variable>
      <variable name="balance" type="number">Current account balance</variable>
      <variable name="currency" type="string">Account currency (USD, EUR, etc)</variable>
      <variable name="digits" type="array">Last N digit values</variable>
      <variable name="activeContract" type="object">Currently open contract details</variable>
      <variable name="trades" type="number">Total trades executed</variable>
      <variable name="wins" type="number">Winning trades</variable>
      <variable name="losses" type="number">Losing trades</variable>
      <variable name="pl" type="number">Cumulative profit/loss</variable>
    </variables>
  </stateManagement>

  <performance>
    <metrics>
      <metric name="totalTrades">Total number of trades</metric>
      <metric name="winRate">Percentage of winning trades</metric>
      <metric name="profitLoss">Cumulative P/L in currency</metric>
      <metric name="avgWin">Average winning trade size</metric>
      <metric name="avgLoss">Average losing trade size</metric>
      <metric name="maxDrawdown">Maximum loss during session</metric>
      <metric name="tradesPerHour">Trading frequency</metric>
    </metrics>

    <optimization>
      <tip>Increase analysisWindow for more stable signals</tip>
      <tip>Decrease threshold for more frequent trades</tip>
      <tip>Increase threshold for selective trading</tip>
      <tip>Use DIGITMATCH for trending markets</tip>
      <tip>Use DIGITDIFF for mean-reverting markets</tip>
      <tip>Monitor win rate and adjust accordingly</tip>
      <tip>Test different symbols for optimal performance</tip>
    </optimization>
  </performance>

  <security>
    <authentication>
      <method>Deriv API Token</method>
      <scope>trade</scope>
      <storage>Environment variables only</storage>
      <transmission>WebSocket Secure (WSS)</transmission>
      <encryption>TLS/SSL</encryption>
    </authentication>

    <requirements>
      <requirement>Valid Deriv account</requirement>
      <requirement>API token with trade scope</requirement>
      <requirement>Internet connection</requirement>
      <requirement>Sufficient account balance</requirement>
    </requirements>

    <bestPractices>
      <practice>Never share API tokens</practice>
      <practice>Rotate tokens regularly</practice>
      <practice>Use separate tokens for demo and real</practice>
      <practice>Monitor account activity</practice>
      <practice>Set strict risk limits</practice>
      <practice>Test in demo mode first</practice>
      <practice>Review trade logs regularly</practice>
    </bestPractices>
  </security>

  <disclaimer>
    <warning>REAL TRADING CAN RESULT IN TOTAL LOSS OF CAPITAL</warning>
    <warning>This is a statistical strategy with no guarantee of profit</warning>
    <warning>Frequency patterns are random and may not repeat</warning>
    <warning>Always use appropriate risk management</warning>
    <warning>Test thoroughly in demo mode before real trading</warning>
    <warning>Only trade with money you can afford to lose</warning>
    <warning>Past performance does not predict future results</warning>
    <warning>Deriv may change API at any time</warning>
  </disclaimer>

  <support>
    <documentation>
      <link>https://github.com/maddy1749/deriv-riff-bot</link>
      <link>https://developers.deriv.com/</link>
      <link>https://app.deriv.com/</link>
    </documentation>

    <troubleshooting>
      <issue name="Bot not loading">
        <solution>Ensure XML is valid and well-formed</solution>
        <solution>Check all required fields are present</solution>
        <solution>Verify API token is set</solution>
      </issue>

      <issue name="Bot not trading">
        <solution>Check authorization status</solution>
        <solution>Verify account has sufficient balance</solution>
        <solution>Check strategy threshold settings</solution>
        <solution>Monitor for error messages</solution>
      </issue>

      <issue name="Connection errors">
        <solution>Check internet connection</solution>
        <solution>Verify WebSocket URL is correct</solution>
        <solution>Ensure Deriv API is accessible</solution>
        <solution>Check firewall settings</solution>
      </issue>
    </troubleshooting>
  </support>

  <status>
    <lastUpdated>2026-08-29</lastUpdated>
    <version>1.0.0</version>
    <buildStatus>Production Ready</buildStatus>
    <compatibility>Deriv API v3</compatibility>
  </status>

</bot>
